# ==================================================================
# PRODUCTION environment template — Duka AI Backend
# ==================================================================
# This is DIFFERENT from .env.example (which is for local/sandbox
# development). Copy this file's structure into your Render/Railway
# dashboard environment variables (or a real .env on your VPS) once
# you're ready to go live - do NOT reuse your sandbox values here.
#
# Anything marked "GET THIS FROM:" needs a real value from that real
# source - none of these have safe example defaults like the sandbox
# ones did.
# ==================================================================

NODE_ENV=production

# --- AI provider ---
# GET THIS FROM: https://openrouter.ai/keys (can reuse your existing
# key - OpenRouter doesn't have separate sandbox/production keys)
OPENROUTER_API_KEY=

OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Database ---
# GET THIS FROM: Supabase project settings > Database > Connection string
# (can reuse the same Supabase database you've already been using -
# no need for a separate "production" database unless you want one)
DATABASE_URL=

# --- Meta / WhatsApp (PRODUCTION Embedded Signup, not your test number) ---
# GET THESE FROM: Meta App Dashboard > App Settings > Basic
META_APP_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v21.0

# Any secret string you make up yourself - must match exactly what you
# enter in Meta's webhook config dashboard
META_WEBHOOK_VERIFY_TOKEN=

# GET THIS FROM: Meta App Dashboard > WhatsApp > Embedded Signup Builder
# (only usable once Business Verification is approved)
META_EMBEDDED_SIGNUP_CONFIG_ID=

# --- M-Pesa Daraja — PRODUCTION (not sandbox) ---
MPESA_BASE_URL=https://api.safaricom.co.ke

# GET THESE FROM: developer.safaricom.co.ke, after creating a
# PRODUCTION app (not a sandbox app) and completing Safaricom's go-live
# process with your real Paybill
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# GET THESE FROM: Safaricom, once your Paybill application is approved
# (see PRODUCTION_CHECKLIST.md) - these are NOT the same as the sandbox
# shortcode 174379 / shared sandbox passkey
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Set this AFTER your first production deploy, once you know your real
# public URL (e.g. https://duka-ai-backend.onrender.com/api/mpesa/callback)
# No ngrok needed in production - your host provides a permanent HTTPS URL.
MPESA_CALLBACK_URL=

# --- Admin panel ---
# Generate a NEW strong random key for production - do not reuse your
# local/dev ADMIN_API_KEY
ADMIN_API_KEY=

# --- CORS ---
# Comma-separated list of real frontend origins that should be allowed
# to call this API - e.g. your GitHub Pages URL and/or custom domain.
# Do NOT leave this as "*" in production.
ALLOWED_ORIGIN=

# --- Billing scheduler ---
# 1 hour in production. Do NOT set this to a fast testing value
# (like 60000) in production - that was only for local development.
BILLING_CYCLE_INTERVAL_MS=3600000

# --- Port ---
# Leave unset in most cases - Render/Railway inject this automatically.
# Only set explicitly for a VPS/Docker deployment.
# PORT=3000
