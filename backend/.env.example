# DEPRECATED - no longer used now that the AI provider is OpenRouter
# (see OPENROUTER_API_KEY below). Left here only in case you want to
# roll back to geminiService.js temporarily.
# GEMINI_API_KEY=your_gemini_api_key_here

# Get a free key at https://openrouter.ai/keys - this is now the AI
# provider for both prompt generation and live chat replies.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional - defaults to google/gemini-2.5-flash if not set.
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional - shown in OpenRouter's own analytics, not required to function.
APP_PUBLIC_URL=https://duka-ai.example.com

# From your Meta App Dashboard > App Settings > Basic
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# From App Dashboard > WhatsApp > Embedded Signup Builder (the "config_id")
# This goes in the FRONTEND code (script.js), not here - listed here only
# as a reminder of where to find it.
# META_EMBEDDED_SIGNUP_CONFIG_ID=your_config_id

# Graph API version to call (check developers.facebook.com for the latest)
GRAPH_API_VERSION=v21.0

# Any secret string you make up yourself - Meta echoes it back during
# webhook verification to confirm you control this server. Also enter
# this same value in the Meta App Dashboard's webhook config.
META_WEBHOOK_VERIFY_TOKEN=choose_your_own_secret_string

# For testing your own free Meta test number before Business Verification
# is complete (see backend/scripts/seedTestBusiness.js). Get these from
# Meta App Dashboard > WhatsApp > API Setup / "Try it out".
META_ACCESS_TOKEN=your_permanent_or_temporary_test_token
META_TEST_PHONE_NUMBER_ID=your_test_phone_number_id
# The WhatsApp Business Account ID tied to your test number above -
# needed to subscribe your app to receive webhook events for it.
META_TEST_WABA_ID=your_test_waba_id

# PostgreSQL connection string. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dukaai

# M-Pesa Daraja API - SANDBOX credentials for testing (no real money moves).
# Get MPESA_CONSUMER_KEY/SECRET by creating an app at developer.safaricom.co.ke
# selecting "Lipa Na M-Pesa Sandbox". The shortcode/passkey below are
# Safaricom's shared sandbox test values - safe to use as-is for testing.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be a public HTTPS URL (ngrok while testing) ending in your callback route
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.dev/api/mpesa/callback

# How often (in milliseconds) the server checks for expired trials and
# renewals due for billing. Defaults to 1 hour if not set. Lower this
# temporarily while testing so you don't have to wait an hour to see it fire.
# BILLING_CYCLE_INTERVAL_MS=60000

# Port the backend server runs on
PORT=3000

# Comma-separated list of origins allowed to call this API (your frontend's URL)
ALLOWED_ORIGIN=http://localhost:5500

# Any secret string you make up yourself - required in the "x-admin-key"
# header to access any /api/admin/* route (the admin panel).
ADMIN_API_KEY=choose_a_strong_secret_here
